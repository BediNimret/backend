<div class="flex">
  <nav class="flex h-screen w-[250px] flex-col items-center bg-blue-200 p-4">
    <% if (files && files.length) { %>
      <% files.forEach((file) => { %>
        <button
          type="button"
          class="mb-2 rounded bg-white px-3 py-2"
          onclick="openFile('<%= file %>')"
        >
          Open <%= file %>
        </button>
      <% }); %>
    <% } %>

    <form action="/createFile" method="post" class="mt-4 flex flex-col items-center">
      <input
        type="text"
        name="fileName"
        placeholder="Enter File Name"
        class="m-2 w-[150px] bg-blue-50 p-2 text-amber-950"
      />
      <button type="submit" class="w-[150px] bg-amber-950 p-2 text-blue-50">
        Add New File
      </button>
    </form>
  </nav>

  <div class="relative flex flex-1 flex-col p-4">
    <button
      type="button"
      id="save-btn"
      class="mb-2 self-end rounded bg-green-600 px-3 py-2 text-white"
      onclick="saveFile()"
    >
      Save
    </button>

    <textarea
      id="file-textarea"
      class="h-full w-full resize-none rounded border border-gray-300 bg-white p-4"
      placeholder="Open a file to edit..."
    ></textarea>
  </div>
</div>

<script>
  let currentFileName = null;

  async function openFile(fileName) {
    currentFileName = fileName;
    try {
      const response = await axios.get(`/readFile/${fileName}`);
      document.getElementById("file-textarea").value = response.data.data;
    } catch (err) {
      console.error(err);
    }
  }

  async function saveFile() {
    if (!currentFileName) return;

    try {
      const content = document.getElementById("file-textarea").value;

      await axios.post(`/saveFile/${currentFileName}`, {
        content,
      });

      alert("File saved successfully");
    } catch (err) {
      console.error(err);
      alert("Save failed");
    }
  }
</script>